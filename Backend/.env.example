# ============================================================
# GoRag Backend Environment Variables
# Configure these in Render Dashboard -> Environment Variables
# ============================================================

# Google Gemini API Key (Required for answer generation)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model identifier (Default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Qdrant Vector Cloud (Required for vector storage & retrieval)
# Obtain from: https://cloud.qdrant.io/
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# Frontend URL for CORS (Optional - *.vercel.app is allowed automatically)
FRONTEND_URL=https://your-app.vercel.app

# Set to true only if deploying on machines with > 2GB RAM
ENABLE_CLIP=false
